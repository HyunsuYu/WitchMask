    FurnitureSprite: {fileID: 21300000, guid: 02ebef811ac32ff44895c6408d47aab8, type: 3}
  - Name: "\uC870\uAC1C \uAECD\uB370\uAE30 \uCC2C\uC7A5"
    Hint: "\uC870\uAC1C \uC138 \uAC1C\uAC00 \uBD81\uC11C, \uB3D9, \uB0A8\uC11C\uC5D0
      \uC790\uB9AC\uB97C \uC7A1\uC73C\uBA74, \uBBF8\uC5ED \uD55C \uC904\uAE30\uAC00
