  Recipes:
  - Name: "\uB124\uBAA8\uD544\uB77C \uD3EC\uADFC \uCE68\uB300"
    Hint: "\uD478\uB978 \uAF43 \uB450 \uC1A1\uC774\uB294 \uBC29\uC758 \uC11C\uB298\uD55C
      \uBD81\uC11C\uCABD\uACFC \uB0A8\uC11C\uCABD\uC5D0 \uB450\uACE0, \uB2EC\uCF64\uD55C
      \uAFC0 \uD55C \uBC29\uC6B8\uC740 \uB0A8\uB3D9\uCABD \uB05D\uC5D0 \uB454\uB2E4."
    ConsumedItems: 01000000ffffff7fffffff7fffffff7f0100000004000000
    Image: {fileID: 21300000, guid: f2e0d87934b8e454988b94e1f272fb22, type: 3}
  - Name: "\uD669\uB9E4\uD654 \uC6D0\uBAA9 \uC218\uB0A9\uC7A5"
    Hint: "\uD669\uAE08\uBE5B \uAF43\uB4E4\uC774 \uC67C\uCABD \uB77C\uC778\uC744
      \uB530\uB77C \uD53C\uC5B4\uB098\uACE0, \uADF8 \uC911\uC2EC\uC758 \uC624\uB978\uCABD\uC5D0
      \uB2E8\uB2E8\uD55C \uC528\uC557 \uD558\uB098\uB97C \uC2EC\uC5B4\uC918."
    ConsumedItems: 02000000ffffff7f020000000500000002000000ffffff7f
    Image: {fileID: 21300000, guid: 04095c53dcbbf8e47a05f9853f74aaa3, type: 3}
  - Name: "\uD558\uC580 \uCF54\uC2A4\uBAA8\uC2A4 \uD2F0\uD14C\uC774\uBE14"
    Hint: "\uD558\uC580 \uAF43 \uB450 \uC1A1\uC774\uB294 \uBD81\uB3D9\uCABD\uACFC
      \uB0A8\uC11C\uCABD\uC5D0 \uB9C8\uC8FC \uBCF4\uAC8C \uB450\uACE0, \uC528\uC557
      \uB450 \uC54C\uC740 \uB0A8\uB3D9\uCABD\uACFC \uC11C\uCABD\uC5D0 \uB193\uC544
      \uADE0\uD615\uC744 \uB9DE\uCDB0\uBD10."
    ConsumedItems: ffffff7f0300000009000000ffffff7f0300000005000000
    Image: {fileID: 21300000, guid: 60b29b58cc9a57a4f9c9529555e5700d, type: 3}
  - Name: "\uB098\uBE44 \uB0A0\uAC1C \uBB34\uC9C0\uAC1C\uCC3D"
    Hint: "\uB098\uBE44\uB294 \uAC00\uC7A5 \uB192\uC740 \uBD81\uCABD\uC5D0\uC11C
      \uB0A0\uAC2F\uC9D3\uD558\uACE0, \uB9D1\uC740 \uBB3C\uBC29\uC6B8 \uB450 \uAC1C\uB294
      \uC67C\uCABD\uC758 \uC704\uC544\uB798\uC5D0 \uACE0\uC5EC\uC788\uB2E8\uB2E4."
    ConsumedItems: 06000000ffffff7f0d000000ffffff7f0d000000ffffff7f
    Image: {fileID: 21300000, guid: 6d90174aa8af45e478634446126bf9cd, type: 3}
  - Name: "\uD2A4\uB9BD \uBB3C\uBC29\uC6B8 \uC2A4\uD0E0\uB4DC"
    Hint: "\uBD89\uC740 \uAF43\uC740 \uAF2D\uB300\uAE30\uC5D0 \uD53C\uC5B4\uB098\uACE0,
      \uC2DC\uC6D0\uD55C \uBB3C\uBC29\uC6B8\uC740 \uB3D9\uCABD \uB05D\uC5D0 \uB9FA\uD78C\uB2E4."
    ConsumedItems: 00000000ffffff7fffffff7f0d000000ffffff7fffffff7f
    Image: {fileID: 21300000, guid: 18a92012e6aa2ed4b8728a6c1ac6d845, type: 3}
  - Name: "\uAFC0\uB2E8\uC9C0 \uC2A4\uD234"
    Hint: " \uB2EC\uCF64\uD568\uC774 \uBD81\uB3D9\uCABD\uACFC \uB0A8\uC11C\uCABD\uC5D0
      \uAC00\uB4DD \uCC28\uBA74, \uC549\uAE30 \uB531 \uC88B\uC740 \uC758\uC790\uAC00
      \uC644\uC131\uB420 \uAC70\uC57C."
    ConsumedItems: ffffff7f04000000ffffff7fffffff7f04000000ffffff7f
    Image: {fileID: 21300000, guid: c02d3ac58491a3e4b848ca7208f896aa, type: 3}
  - Name: "\uAF43\uC78E \uC5EE\uC740 \uCE74\uD398\uD2B8"
    Hint: "\uBD81\uCABD\uC5D4 \uD2A4\uB9BD, \uC11C\uCABD\uC5D4 \uD669\uB9E4\uD654,
      \uB0A8\uC11C\uCABD\uC5D4 \uB124\uBAA8\uD544\uB77C\uB97C \uB450\uC5B4 \uC67C\uCABD
      \uBC18\uC6D0\uC744 \uADF8\uB824\uBD10."
    ConsumedItems: 00000000ffffff7f02000000ffffff7f01000000ffffff7f
    Image: {fileID: 21300000, guid: fcbfae7c8e8285a4babdd8b9462c5e97, type: 3}
  - Name: "\uC9C4\uC8FC \uAF43 \uC790\uC218 \uC561\uC790"
    Hint: "\uBC14\uB2E4\uC758 \uBCF4\uC11D\uC740 \uAC00\uC7A5 \uC704\uC5D0, \uD558\uC580
      \uAF43\uC740 \uB3D9\uCABD\uC5D0 \uB450\uC5B4 \uC11C\uB85C\uB97C \uBE44\uC2A4\uB4EC\uD788
      \uBC14\uB77C\uBCF4\uAC8C \uD574\uC918."
    ConsumedItems: 07000000ffffff7fffffff7f02000000ffffff7fffffff7f
    Image: {fileID: 21300000, guid: 3a2d5e1bde871a848bf42d942532ab67, type: 3}
  - Name: "\uC528\uC557 \uC8FC\uBA38\uB2C8\uC640 \uC870\uAC1C\uD568"
    Hint: "\uC528\uC557 \uB450 \uC54C\uC744 \uB098\uB780\uD788 \uC704\uCABD\uC5D0
      \uB2F4\uACE0, \uBC14\uB2E4\uC758 \uAECD\uB370\uAE30\uB294 \uB3D9\uCABD\uC5D0
      \uB450\uC5B4 \uBC1B\uCCD0\uBCF4\uC790."
    ConsumedItems: 0500000005000000ffffff7f08000000ffffff7fffffff7f
    Image: {fileID: 21300000, guid: b329fe8078748654fb3fbf6fe8d41548, type: 3}
  - Name: "\uBB3C\uBC29\uC6B8 \uBA38\uAE08\uC740 \uB124\uBAA8\uD544\uB77C \uD654\uBD84"
    Hint: "\uD478\uB978 \uAF43\uC740 \uBD81\uCABD\uC5D0 \uD53C\uC6B0\uACE0, \uADF8
      \uC544\uB798 \uC138 \uBC29\uD5A5\uC744 \uBB3C\uBC29\uC6B8\uC774 \uC6C5\uB369\uC774\uCC98\uB7FC
      \uAC10\uC2F8\uACE0 \uC788\uC5B4."
    ConsumedItems: 01000000ffffff7f0d0000000d0000000d000000ffffff7f
    Image: {fileID: 21300000, guid: d46d99daa9e562c4ba7babc0d8e0ec22, type: 3}
  - Name: "\uC0B0\uD638 \uC9C4\uC8FC \uCE68\uB300"
    Hint: "\uBD89\uC740 \uC0B0\uD638\uAC00 \uBD81\uCABD\uACFC \uB0A8\uC11C\uCABD\uC73C\uB85C
      \uBF08\uB300\uB97C \uC7A1\uACE0, \uC601\uB871\uD55C \uC9C4\uC8FC\uB294 \uBD81\uB3D9\uCABD\uC5D0\uC11C
      \uBE5B\uB098\uACE0 \uC788\uC5B4."
    ConsumedItems: 0b000000ffffff7fffffff7fffffff7f0b00000009000000
    Image: {fileID: 21300000, guid: 6563955532268984a81b2f5dc8ef4a92, type: 3}
  - Name: "\uC870\uAC1C \uAECD\uB370\uAE30 \uCC2C\uC7A5"
    Hint: "\uC870\uAC1C \uC138 \uAC1C\uAC00 \uC67C\uCABD \uB77C\uC778\uC744 \uB530\uB77C
      \uC790\uB9AC\uB97C \uC7A1\uACE0, \uB9C8\uC9C0\uB9C9 \uBBF8\uC5ED \uD55C \uC904\uAE30\uB294
      \uB0A8\uB3D9\uCABD\uC5D0 \uAC78\uCCD0\uB450\uB834."
    ConsumedItems: 08000000ffffff7f08000000ffffff7f0800000009000000
