  - Name: "\uBC1C\uAD11 \uBE44\uB298 \uB4F1\uBD88"
    Hint: "\uBC18\uC9DD\uC774\uB294 \uBE44\uB298\uC740 \uBD81\uCABD\uACFC \uB0A8\uC11C\uCABD\uC5D0,
