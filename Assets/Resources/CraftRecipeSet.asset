  Recipes:
  - Name: "\uB124\uBAA8\uD544\uB77C \uD3EC\uADFC \uCE68\uB300"
    Hint: "\uD478\uB978 \uAF43 \uB450 \uC1A1\uC774\uAC00 \uC67C\uCABD \uC704\uC544\uB798
      \uB05D\uC744 \uC7A1\uACE0, \uADF8 \uC0AC\uC774 \uC11C\uCABD \uD1B5\uB85C\uC5D0
      \uB2EC\uCF64\uD55C \uAFC0\uC744 \uBC1C\uB77C\uB450\uB834."
    ConsumedItems: 01000000ffffff7fffffff7fffffff7f0100000004000000
    FurnitureSprite: {fileID: 21300000, guid: f2e0d87934b8e454988b94e1f272fb22, type: 3}
  - Name: "\uD669\uB9E4\uD654 \uC6D0\uBAA9 \uC218\uB0A9\uC7A5"
    Hint: "\uBD81\uC11C\uCABD\uC5D0\uC11C \uC2DC\uC791\uD574 \uB3D9\uCABD\uC744 \uAC70\uCCD0
      \uB0A8\uC11C\uCABD\uC73C\uB85C \uAD7D\uC774\uCE58\uB294 \uAF43\uAE38\uC744
      \uB9CC\uB4E4\uACE0, \uB9C8\uC9C0\uB9C9 \uB0A8\uB3D9\uCABD \uAD6C\uC11D\uC5D4
      \uC528\uC557\uC744 \uC2EC\uC5B4\uC918."
    ConsumedItems: 02000000ffffff7f020000000500000002000000ffffff7f
    FurnitureSprite: {fileID: 21300000, guid: 04095c53dcbbf8e47a05f9853f74aaa3, type: 3}
  - Name: "\uD558\uC580 \uCF54\uC2A4\uBAA8\uC2A4 \uD2F0\uD14C\uC774\uBE14"
    Hint: "\uD558\uC580 \uAF43\uC774 \uBD81\uB3D9\uCABD\uACFC \uB0A8\uC11C\uCABD\uC5D0\uC11C
      \uB9C8\uC8FC \uBCF4\uBA70 \uB300\uCE6D\uC744 \uC774\uB8E8\uACE0, \uC528\uC557
      \uB450 \uC54C\uC740 \uC591\uC606 \uC911\uC559\uC5D0 \uB098\uB780\uD788 \uB193\uC544
      \uADE0\uD615\uC744 \uC7A1\uC544\uBD10."
    ConsumedItems: ffffff7f0300000005000000ffffff7f0300000005000000
    FurnitureSprite: {fileID: 21300000, guid: 60b29b58cc9a57a4f9c9529555e5700d, type: 3}
  - Name: "\uB098\uBE44 \uB0A0\uAC1C \uBB34\uC9C0\uAC1C\uCC3D"
    Hint: "\uB098\uBE44\uB294 \uC67C\uCABD \uB192\uC740 \uACF3\uC5D0 \uC549\uD788\uACE0,
      \uB9D1\uC740 \uBB3C\uBC29\uC6B8\uC740 \uB3D9\uCABD\uACFC \uB0A8\uC11C\uCABD\uC5D0
      \uB9FA\uD788\uAC8C \uD574\uC918."
    ConsumedItems: 06000000ffffff7f0d000000ffffff7f0d000000ffffff7f
    FurnitureSprite: {fileID: 21300000, guid: 6d90174aa8af45e478634446126bf9cd, type: 3}
  - Name: "\uD2A4\uB9BD \uBB3C\uBC29\uC6B8 \uC2A4\uD0E0\uB4DC"
    Hint: "\uBD89\uC740 \uAF43\uC740 \uBD81\uC11C\uCABD \uAF2D\uB300\uAE30\uC5D0,
      \uC2DC\uC6D0\uD55C \uBB3C\uBC29\uC6B8\uC740 \uAC00\uC7A5 \uBA3C \uB0A8\uB3D9\uCABD
      \uB300\uAC01\uC120 \uB05D\uC5D0 \uB450\uB834."
    ConsumedItems: 00000000ffffff7fffffff7f0d000000ffffff7fffffff7f
    FurnitureSprite: {fileID: 21300000, guid: 18a92012e6aa2ed4b8728a6c1ac6d845, type: 3}
  - Name: "\uAFC0\uB2E8\uC9C0 \uC2A4\uD234"
    Hint: "\uBD81\uB3D9\uCABD\uACFC \uB0A8\uC11C\uCABD \uB05D\uC5D0 \uAFC0\uC744
      \uD55C \uBC29\uC6B8\uC529 \uB5A8\uC5B4\uB728\uB9AC\uBA74, \uB2EC\uCF64\uD568\uC774
      \uAD50\uCC28\uD558\uBA70 \uC758\uC790\uAC00 \uC644\uC131\uB420 \uAC70\uC57C."
    ConsumedItems: ffffff7f04000000ffffff7fffffff7f04000000ffffff7f
    FurnitureSprite: {fileID: 21300000, guid: c02d3ac58491a3e4b848ca7208f896aa, type: 3}
  - Name: "\uAF43\uC78E \uC5EE\uC740 \uCE74\uD398\uD2B8"
    Hint: "\uBD81\uC11C-\uB3D9-\uB0A8\uC11C \uC21C\uC11C\uB85C \uAF43\uC744 \uB193\uC544
      \uB113\uC740 \uC0BC\uAC01\uD615\uC744 \uADF8\uB824\uBCF4\uB834. \uAF43\uAE38\uC774
      \uAC70\uC2E4\uC744 \uAC00\uB4DD \uCC44\uC6B8 \uAC70\uC57C."
    ConsumedItems: 00000000ffffff7f02000000ffffff7f01000000ffffff7f
    FurnitureSprite: {fileID: 21300000, guid: fcbfae7c8e8285a4babdd8b9462c5e97, type: 3}
  - Name: "\uC9C4\uC8FC \uAF43 \uC790\uC218 \uC561\uC790"
    Hint: "\uC67C\uCABD \uC704\uC5D4 \uBC14\uB2E4\uC758 \uBCF4\uC11D\uC744, \uC624\uB978\uCABD
      \uC544\uB798\uC5D4 \uD558\uC580 \uAF43\uC744 \uB450\uC5B4 \uC11C\uB85C \uBE44\uC2A4\uB4EC\uD788
      \uB208\uC744 \uB9DE\uCD94\uAC8C \uD574\uC918."
    ConsumedItems: 07000000ffffff7fffffff7f02000000ffffff7fffffff7f
    FurnitureSprite: {fileID: 21300000, guid: 5899504bc16604c4d962075cb4ae623a, type: 3}
  - Name: "\uC528\uC557 \uC8FC\uBA38\uB2C8\uC640 \uC870\uAC1C\uD568"
    Hint: "\uC528\uC557 \uB450 \uC54C\uC744 \uC704\uCABD \uB77C\uC778\uC5D0 \uB098\uB780\uD788
      \uC62C\uB9AC\uACE0, \uB0A8\uB3D9\uCABD \uBAA8\uC11C\uB9AC\uC5D0 \uC870\uAC1C\uB97C
      \uB450\uC5B4 \uBC1B\uCE68\uB300\uB85C \uC0BC\uC790."
    ConsumedItems: 0500000005000000ffffff7f08000000ffffff7fffffff7f
    FurnitureSprite: {fileID: 21300000, guid: b329fe8078748654fb3fbf6fe8d41548, type: 3}
  - Name: "\uBB3C\uBC29\uC6B8 \uBA38\uAE08\uC740 \uB124\uBAA8\uD544\uB77C \uD654\uBD84"
    Hint: "\uD478\uB978 \uAF43\uC740 \uBD81\uC11C\uCABD\uC5D0 \uD53C\uC6B0\uACE0,
      \uB098\uBA38\uC9C0 \uC624\uB978\uCABD \uC544\uB798\uC758 \uC138 \uBC29\uD5A5\uC744
      \uBB3C\uBC29\uC6B8\uB85C \uAC00\uB4DD \uCC44\uC6CC\uC918."
    ConsumedItems: 01000000ffffff7f0d0000000d0000000d000000ffffff7f
    FurnitureSprite: {fileID: 21300000, guid: d46d99daa9e562c4ba7babc0d8e0ec22, type: 3}
  - Name: "\uC0B0\uD638 \uC9C4\uC8FC \uCE68\uB300"
    Hint: "\uBD89\uC740 \uC0B0\uD638\uAC00 \uC67C\uCABD \uC704\uC544\uB798\uC5D0\uC11C
      \uB4E0\uB4E0\uD788 \uBC84\uD2F0\uACE0, \uC601\uB871\uD55C \uC9C4\uC8FC\uB294
      \uBD81\uB3D9\uCABD \uB05D\uC5D0\uC11C \uBE5B\uB098\uACE0 \uC788\uC5B4."
